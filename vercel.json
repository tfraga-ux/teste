{
  "rewrites": [
    { "source": "/", "destination": "/13f_demo_report.html" },
    { "source": "/live", "destination": "/13f_report.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
